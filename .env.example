# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй.

# ОБЯЗАТЕЛЬНО: токен бота-пульта от @BotFather
BOT_TOKEN=

# Необязательно: ключ с console.anthropic.com — тогда письма пишет нейросеть под каждую вакансию.
# Пусто — работают шаблоны.
ANTHROPIC_API_KEY=

# ── Полный режим (необязательно) ──────────────────────────────
# Если заполнить — бот сам отправляет письмо и PDF по кнопке и читает ещё и чаты.
# Пусто — лёгкий режим: читает каналы через веб, по кнопке открывается чат с готовым письмом.
# Ключи с my.telegram.org → API development tools; TG_SESSION выдаёт login.py
TG_API_ID=
TG_API_HASH=
TG_SESSION=
